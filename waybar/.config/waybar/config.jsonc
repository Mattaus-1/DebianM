{
  "layer": "top", "position": "top", "height": 34,
  "margin-top": 5, "margin-left": 20, "margin-right": 20, "spacing": 6,
  "modules-left": ["custom/menu", "hyprland/workspaces", "custom/swaync", "tray"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory", "disk", "pulseaudio"],
  "custom/menu": {"format": "", "tooltip-format": "Aplicativos", "on-click": "wofi --show drun"},
  "hyprland/workspaces": {
    "all-outputs": false, "format": "{icon}",
    "format-icons": {"active": "━", "default": "─", "persistent": "─"}
  },
  "custom/swaync": {
    "format": "{icon}", "return-type": "json", "exec": "swaync-client -swb",
    "on-click": "swaync-client -t", "on-click-right": "swaync-client -d",
    "format-icons": {"notification": "", "none": "", "dnd-notification": "", "dnd-none": "", "inhibited-notification": "", "inhibited-none": "", "dnd-inhibited-notification": "", "dnd-inhibited-none": ""}
  },
  "tray": {"icon-size": 16, "spacing": 8},
  "clock": {"format": " {:%H:%M:%S}", "interval": 1, "tooltip-format": "{:%A, %d de %B de %Y}"},
  "cpu": {"format": "{usage}% 󰍛", "on-click": "kitty -e btop"},
  "memory": {"format": "{used:0.1f}G 󰾆", "on-click": "kitty -e btop"},
  "disk": {"path": "/", "format": "{percentage_used}% 󰋊"},
  "pulseaudio": {"format": "{icon} {volume}%", "format-muted": "󰖁", "format-icons": {"default": ["", "", ""]}, "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"}
}
